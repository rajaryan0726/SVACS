# SVACS Backend Environment Variables
# Copy this file to .env and fill in the values

# ── Gemini Vision API ──────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# ── Device Configuration ───────────────────────────────────
# auto | cuda | cpu
VISION_DEVICE=auto

# ── Existing SVACS Configuration ───────────────────────────
# YOLO_MODEL_PATH=vessel_front_model.pt
# CLASSIFIER_MODEL_PATH=efficientnet_vessel_best.pth
# CLASSIFIER_MIN_CONFIDENCE=0.60
# OCR_ENABLED=true
# REPLAY_STORAGE_DIR=/tmp/svacs_replays
